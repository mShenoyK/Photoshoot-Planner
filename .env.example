# Local demo only; production refuses demo mode.
DATA_MODE=mock
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://framecraft:localdev@localhost:5432/framecraft
WEB_BASE_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
STORAGE_ENDPOINT=https://example.invalid
STORAGE_REGION=region
STORAGE_BUCKET=framecraft-private
STORAGE_ACCESS_KEY_ID=replace_me
STORAGE_SECRET_ACCESS_KEY=replace_me
AI_TEXT_PROVIDER=mock
AI_VISION_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_EMBEDDINGS_PROVIDER=mock
ENABLE_IMAGE_GENERATION=false
MAX_IMAGE_UPLOAD_MB=15

API_BASE_URL=http://localhost:3000/api/v1
AI_API_KEY=replace_me

# local is development-only; production must use a private S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/private-objects
STORAGE_FORCE_PATH_STYLE=false
# Optional PEM CA bundle path for a private database CA. Hostname verification stays enabled.
# DB_SSL_CA_FILE=/secure/path/database-ca.pem

# Knowledge / planning defaults: no paid AI calls.
KNOWLEDGE_ADMIN_EMAILS=
ENABLE_EMBEDDINGS=false
# Local mock only. Production must use bullmq and a separately running worker.
QUEUE_DRIVER=mock
MOCK_QUEUE_AUTO_RUN=true
