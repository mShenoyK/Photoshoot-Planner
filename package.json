{
  "name": "framecraft-ai",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @framecraft/web dev",
    "build": "pnpm --filter @framecraft/web build",
    "start": "pnpm --filter @framecraft/web start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "PRISMA_GENERATE_SKIP_AUTOINSTALL=true corepack pnpm --filter @framecraft/database db:generate",
    "db:migrate": "corepack pnpm --filter @framecraft/database db:migrate",
    "db:seed": "tsx packages/database/seed.ts",
    "db:check": "tsx scripts/check-database.ts",
    "worker": "tsx workers/jobs/run.ts",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@framecraft/ai": "workspace:*",
    "@framecraft/knowledge": "workspace:*",
    "@framecraft/shared": "workspace:*",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "6.19.0",
    "bullmq": "^6.7.1",
    "ioredis": "^6.0.0",
    "jose": "^6.1.3",
    "pdfjs-dist": "^5.4.624",
    "sharp": "^0.35.5",
    "zod": "^3.25.76",
    "tsx": "^4.20.6",
    "pdf-lib": "^1.17.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
